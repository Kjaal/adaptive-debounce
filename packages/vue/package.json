{
  "name": "@adaptive-debounce/vue",
  "version": "0.1.0-rc.1",
  "description": "Vue integration for adaptive-debounce.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kjaal/adaptive-debounce.git",
    "directory": "packages/vue"
  },
  "bugs": {
    "url": "https://github.com/Kjaal/adaptive-debounce/issues"
  },
  "homepage": "https://github.com/Kjaal/adaptive-debounce#readme",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "prepack": "pnpm build",
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "adaptive-debounce": "workspace:^"
  },
  "peerDependencies": {
    "vue": ">=3.5.0 <4.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.10",
    "happy-dom": "20.11.6",
    "tsdown": "0.22.14",
    "typescript": "7.0.2",
    "vitest": "4.1.11",
    "vue": "3.5.41"
  }
}
