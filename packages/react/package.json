{
  "name": "@adaptive-debounce/react",
  "version": "0.0.0",
  "description": "React Provider and hooks for adaptive-debounce.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kjaal/adaptive-debounce.git",
    "directory": "packages/react"
  },
  "bugs": {
    "url": "https://github.com/Kjaal/adaptive-debounce/issues"
  },
  "homepage": "https://github.com/Kjaal/adaptive-debounce#readme",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "scripts": {
    "build": "tsdown",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "prepack": "pnpm build",
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "adaptive-debounce": "workspace:^"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.10",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "happy-dom": "20.11.6",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "tsdown": "0.22.14",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  },
  "publishConfig": {
    "access": "public"
  }
}
